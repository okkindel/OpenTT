    bounce_explosion: "DefaultExplosion",
    other_explosion: "ScatterExplosion",
    reticle: "ScatterReticle",
    pellet_count: 7,
    spread_angle: 6,
    spread_ring: 1,
    spread_inner: 1,
    spread_jitter: 0.2,
    trail_length: 1.6,
    max_life_ms: 600,
    fire_sound: "ScatterFire",
