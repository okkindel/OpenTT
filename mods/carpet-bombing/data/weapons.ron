    bounce_explosion: "DefaultExplosion",
    other_explosion: "MortarExplosion",
    reticle: "MortarReticle",
    emitter: "MortarSmokeEmitter",
    launch_pitch_min: 50,
    launch_pitch_max: 65,
    launch_range_min: 20,
    launch_range_max: 150,
    fire_sound: "MortarFire",
    display_shape: "models/projectiles/mortarrocket.dts",
    exhaust_glow: "models/projectiles/scatterprojectile.png",
    exhaust_glow_size: 2.0,
    exhaust_offset: 1.0,
    pellet_count: 9,
    spread_angle: 18,
    spread_ring: 1,
    spread_inner: 0.5,
    spread_jitter: 1,
  ),
  // Scatter shot: seven pellets per shot in a cone (one in the
  // middle, six evenly on a 6 degree ring, the ring turned a little per
  // shot), gone after 0.6 s (about 66 m): a
  // full hit close up takes 4.55 (Light tank in 3 shots, Medium 4, Heavy
  // 5), fewer pellets hit further out. Small yellow-orange pellets with a
  // short tracer streak.
  ProjectileDef(
    name: "ScatterProjectile",
    velocity: 110,
    inherit_velocity: 0.97,
    bounces: 0,
    blast_radius: 0,
    rounds: 16,
    keep_previous_weapon: 1,
