// The power-ups, and the power-up weapons a weapon pick-up rolls: per
// weapon its projectile and the sound played when it is picked up;
// `weight` (default 1): how many slots of the roll the weapon fills,
// i.e. its share of the random pick.
// See tt_assets::data::defs for the fields.
#![enable(implicit_some)]
#![enable(unwrap_variant_newtypes)]
(
  pickups: [
    PowerUpDef(
      name: "BrainData",
      category: "PowerUp",
      shape: "models/tanks/brain.dts",
      kind: "brain",
      shadow: 1,
