// Carpet Bombing (example mod): this is the game's data/weapons.ron with
// the Mortar (MortarProjectile, near the middle) turned into a carpet bomb.
// A data file of a mod replaces the whole file, so this is a full copy;
// only these fields of MortarProjectile differ (a test keeps the rest in
// step with the game's file):
//   pellet_count 9, spread_angle 18, spread_ring 1, spread_inner 0.5,
//   spread_jitter 1  (new: nine shells a shot in a cone; the cone turns a
//                    little each shot, so the shots land between each other)
//   volley_size 1 -> 3, reload_ms 1800 -> 250  (three shots a pull)
//   volley_delay_ms 1800 -> 1500  (the next pull)
//   rounds 6 -> 12  (four pulls a pick-up)
//   damage 8 -> 3, blast_radius 11 -> 8  (27 shells a pull: smaller blasts)
// The cartridges a tank fires (projectiles) and their aiming reticles.
// See tt_assets::data::defs for the fields.
#![enable(implicit_some)]
#![enable(unwrap_variant_newtypes)]
[
  ReticleDef(
    name: "DefaultReticle",
    image: "models/reticles/reticle.png",
    size: 1.2,
    start_time: 0.08,
    time_step: 0.18,
    tick_count: 15,
    spacing_exponent: 1.4,
    smooth_near: 0.02,
    smooth_far: 0.63,
    smooth_exponent: 0.2,
    animate: 0,
